# Configuração da operação (uma por canal/conta). O instalar.sh copia este modelo para <operação>/config/operacao.env.
# Só nomes, caminhos e regras. NENHUM segredo aqui: chaves do R2 ficam em config/segredos.env (nunca compartilhar).
# Caminhos relativos são relativos à pasta da operação. $HOME e $LOCALAPPDATA valem em qualquer PC Windows.

# ---- Máquina ----
# "publicador" = a ÚNICA máquina que posta nesta conta (tem a tarefa agendada e o segredos.env).
# "analise"    = só grava, tria, edita e registra.
PAPEL=analise
MAQUINA=pc
# Fuso dos horários de postagem (nome IANA) e o mesmo em formato POSIX para o Git Bash (Brasília = "<-03>3").
FUSO=America/Sao_Paulo
FUSO_POSIX="<-03>3"

# ---- Canal ----
CONTA=meu.canal
# Como o canal se chama na moldura e no texto (ex.: @meu.canal).
ARROBA=@meu.canal
# Jogo/tema principal (entra no gancho, nas regras de seleção e nas hashtags).
TEMA="GTA 6"
# Idioma das legendas.
IDIOMA=pt-BR

# ---- Pastas ----
# Fila de postagem: N_apelido.mp4 + N_apelido.txt (o .txt é a aprovação). Postados vão para fila/postados/.
FILA=fila
# Pasta CURTA para gravações e cortes (o Whisper quebra com caminho longo). Fica fora da operação.
TRAB="$LOCALAPPDATA/Temp"
DADOS=dados

# ---- Postagem (Buffer + Cloudflare R2) ----
PLATAFORMAS="instagram tiktok youtube"
# IDs vêm do conector Buffer (get_account → organização; list_channels → canais). Preencha no PC publicador.
BUFFER_ORG_ID=
BUFFER_CANAL_INSTAGRAM=
BUFFER_CANAL_TIKTOK=
BUFFER_CANAL_YOUTUBE=
# Intervalo entre cortes (min) e limite de posts agendados ao mesmo tempo (plano grátis do Buffer = 10).
INTERVALO_MIN=20
LIMITE_FILA_BUFFER=10
# Categoria do YouTube (20 = Games).
YOUTUBE_CATEGORIA=20
# Hashtag fixa (método SHR: até 3 no total, todas do tema; cada corte soma até 2 do próprio tema).
HASHTAGS="#gta6"
# Linha de crédito obrigatória ({canal} = @ real do streamer).
CREDITO="🎮 Live: {canal}"

# ---- Triagem e nota ----
TRIAGEM_VERSAO=1
FORTES_POR_HORA=6
AMOSTRA_FRACAO=0.15
LIMIAR_FILA=80
LIMIAR_REVISAO=65

# ---- Conformidade (originalidade, direitos, duplicidade) ----
# Redes onde a conta é (ou pode ser) monetizada: lá a autorização do streamer precisa permitir monetização
# ("sim"); "desconhecido" vai para revisão manual e "nao" bloqueia. Deixe vazio só se nenhuma rede monetiza.
MONETIZA="instagram facebook tiktok youtube"
# Perfil por rede: "duração_mín duração_máx(s) texto_máx(caracteres) hashtags_máx". O corte é aprovado por rede.
PERFIL_instagram="15 90 2200 3"
PERFIL_facebook="15 90 2200 3"
PERFIL_tiktok="15 60 2200 3"
PERFIL_youtube="15 60 5000 3"

# ---- Desempenho (o PC também roda FiveM) ----
# Render, Whisper e proxy entram numa fila (um por vez). Threads do ffmpeg e prioridade do Windows (BelowNormal/Idle).
RENDER_THREADS=8
RENDER_PRIORIDADE=BelowNormal
# FiveM aberto: pausar (espera fechar) | leve (FIVEM_THREADS, prioridade Idle, sem GPU) | ignorar
FIVEM_MODO=leve
FIVEM_THREADS=2
