# Copie para <operação>/config/segredos.env SÓ no PC publicador e preencha. Nunca envie este arquivo para ninguém,
# nunca coloque numa pasta de nuvem compartilhada e nunca cole o conteúdo numa conversa.
# Cloudflare R2: bucket com "Public Development URL" ligado (o Buffer exige link público direto do vídeo).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# ex.: https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=
